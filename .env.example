# Copia este archivo a .env y rellénalo. NUNCA subas .env al repositorio.

# Base de datos PostgreSQL. En local: la dirección que da `npm run db:local`. En producción: Neon.
DATABASE_URL="postgresql://usuario:clave@host/basededatos?sslmode=require"
# Solo en local con `npm run db:local`.
SHADOW_DATABASE_URL=""
# Solo en local con `npm run db:local`: pon 1. En producción, déjalo vacío.
DATABASE_POOL_MAX=""

# Inicio de sesión con enlace por email. AUTH_URL es también la dirección que va en los emails.
AUTH_SECRET="genera-un-valor-largo-aleatorio"
AUTH_URL="http://localhost:3000"

# Emails (Resend). Sin clave no salen: se guardan en el buzón de pruebas (/dev/buzon en local).
RESEND_API_KEY=""
EMAIL_FROM="Bonificados <no-reply@tudominio.es>"

# Este email entra siempre como administración.
ADMIN_EMAIL="tu-email@ejemplo.com"

